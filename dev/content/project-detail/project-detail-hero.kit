<div id="project-detail-hero" class="content-padding">
    <div id="project-hero-container">
        <div id="project-hero-left">
            <a href="projects.html" class="back-btn"><i class="fa-solid fa-arrow-left"></i>BACK TO PROJECTS</a>

         <div class="details">
            <h4 class="green-pill" id="project-category"></h4>
            <h4 class="year" id="project-date"></h4>
        </div>

        <h1 id="project-title"></h1>
        <p id="project-description"></p>

        <div id="divide-line"></div>

        <ul>
            <li>
                <h5>CLIENT</h5>
                <h4 id="client-name"></h4>
            </li>

            <li>
                <h5>LOCATION</h5>
                <h4 id="client-location"></h4>
            </li>

            <li>
                <h5>SERVICE</h5>
                <h4 id="project-type"></h4>
            </li>

            <li>
                <h5>DURATION</h5>
                <h4 id="project-timeframe"></h4>
            </li>
        </ul>
        </div>

        <div id="project-hero-right">

        </div>


    </div>
</div>
