<section id="started" class="content-padding">
    <div>
        <h1 class="content-title">Get Started With the FDA</h1>
        <section id="steps-container">
            <div class="steps">
                <div class="step-top">
                    <div class="number">1</div>
                </div>
                <div class="step-bottom">
                    <h3>Request IND #</h3>
                </div>

                <div class="arrow">
                    <div class="arrow-inner">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>
            </div>

            <div class="steps">
                <div class="step-top">
                    <div class="number">2</div>
                </div>
                <div class="step-bottom">
                    <h3>
                        Submit Pre-IND Meeting Request and Briefing Book (4
                        Weeks)
                    </h3>
                </div>
                <div class="arrow">
                    <div class="arrow-inner">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>
            </div>

            <div class="steps">
                <div class="step-top">
                    <div class="number">3</div>
                </div>
                <div class="step-bottom">
                    <h3>FDA Pre-IND Type B Meeting (60 Days)</h3>
                </div>
                <div class="arrow">
                    <div class="arrow-inner">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>
            </div>

            <div class="steps">
                <div class="step-top">
                    <div class="number">4</div>
                </div>
                <div class="step-bottom">
                    <h3>IND Submission (90 Days)</h3>
                </div>
                <div class="arrow">
                    <div class="arrow-inner">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>
            </div>

            <div class="steps">
                <div class="step-top">
                    <div class="number">5</div>
                </div>
                <div class="step-bottom">
                    <h3>IND Lifecycle Management (Annual)</h3>
                </div>
            </div>
        </section>
    </div>
</section>
