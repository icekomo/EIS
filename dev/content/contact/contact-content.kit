<div id="contact-container" class="content-padding">
    <div id="contact-contnet">
        <div id="contact-left">
            <div id="contact-top" class="contact-content">
                <h2>CONTACT INFORMATION</h2>
                <ul>
                    <li>
                        <div class="icon"><i class="fa-solid fa-mobile"></i></div>
                        <div class="content">
                            <h4>CALL US</h4>
                            <a href="tel:+7179408552">717-940-8552</a>
                        </div>
                    </li>

                    <li>
                        <div class="icon"><i class="fa-solid fa-envelope"></i></div>
                        <div class="content">
                            <h4>EMAIL US</h4>
                            <a href="mailto:projects@eisdiv.com">projects@eisdiv.com</a>
                        </div>
                    </li>
                </ul>
            </div>

            <div id="contact-middle" class="contact-content">
                <h2>OUR HEADQUARTERS</h2>
                <ul>
                    <li>
                        <div class="icon"><i class="fa-solid fa-mobile"></i></div>
                        <div class="content">
                            <h4>VISIT US</h4>
                            <address>
                                <a href="">72 West Main St <br>Reinholds PA 17569</a>
                            </address>
                        </div>
                    </li>
                </ul>
            </div>

            <div id="contact-bottom" class="contact-content">
                <h2>BUSINESS HOURS</h2>
                
                <div id="hour-container">
                    <p>MONDAY — FRIDAY</p>
                    <p id="hour-right">8:00 AM — 6:00 PM</p>
                </div>
            </div>

        </div>
        
        <div id="contact-right">
            <h2>SEND A MESSAGE</h2>

            <form>
                <div class="row">
                    <div class="field">
                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="fullName" placeholder="John Doe">
                    </div>
                    <div class="field">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="john@company.com">
                    </div>
                </div>
                <div class="row">
                    <div class="field">
                        <label for="company">Company</label>
                        <input type="text" id="company" name="company" placeholder="Company Name">
                    </div>
                    <div class="field">
                        <label for="serviceType">Service Type</label>
                        <select id="serviceType" name="serviceType">
                            <option>Maintenance</option>
                            <option>Installation</option>
                            <option>Repair</option>
                            <option>Consultation</option>
                        </select>
                    </div>
                </div>
                <div class="full">
                    <label for="projectBrief">Project Brief</label>
                    <textarea id="projectBrief" name="projectBrief"
                        placeholder="Tell us about your project requirements..."></textarea>
                </div>
                <button type="submit">Send Inquiry</button>
            </form>

        </div>
    </div>
</div>